{
  "manifest_version": 2,
  "id": "hatsuhoq.maibot-qq-voice-call",
  "version": "0.4.0",
  "name": "QQ 实时语音",
  "description": "通过独立音频设备桥接 QQ 电话，使用本地识别与情绪语音合成，支持插话打断。",
  "author": {
    "name": "hatsuhoq",
    "url": "https://github.com/hatsuhoq"
  },
  "license": "GPL-3.0-only",
  "urls": {
    "repository": "https://github.com/hatsuhoq/maibot-qq-voice-call"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "999.999.999"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1,<1"
    },
    {
      "type": "python_package",
      "name": "sounddevice",
      "version_spec": ">=0.5.1,<0.6"
    },
    {
      "type": "python_package",
      "name": "webrtcvad-wheels",
      "version_spec": ">=2.0.14,<3"
    }
  ],
  "capabilities": [
    "chat.get_stream_by_user_id",
    "config.get",
    "message.get_recent",
    "message.build_readable",
    "llm.generate",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "changelog": "changelog.md"
}
